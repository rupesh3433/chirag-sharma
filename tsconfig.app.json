{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,

    "lib": ["ES2020", "DOM", "DOM.Iterable"],

    "module": "ESNext",
    "moduleResolution": "node",

    "jsx": "react-jsx",

    "isolatedModules": true,
    "noEmit": true,

    "strict": false,
    "noImplicitAny": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": false,

    "skipLibCheck": true,

    "types": ["react", "react-dom", "leaflet"],
    "esModuleInterop": true,

    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@shared/*": ["src/shared/*"],
      "@admin/*": ["src/admin/*"],
      "@user/*": ["src/user/*"]
    }
  },
  "include": ["src"]
}
